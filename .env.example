# Capacity Connect Environment Template
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_SECRET="replace-with-a-secure-random-32-char-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth via NextAuth
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# AI Studio & Intelligent Recommendations (Groq API: https://console.groq.com)
GROQ_API_KEY=""
GROQ_API_KEY_BACKUP=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional: Firebase Authentication (Google SSO Popup)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
